# Copy to .env and replace with credentials from YOUR test environment.
# NEVER commit .env, authorization codes, live webhooks or customer data.
EMAIL_USER=test-mailbox@example.com
EMAIL_AUTH_CODE=replace_with_your_imap_authorization_code
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993

# Sender signature (optional)
SENDER_NAME=
SENDER_TITLE=
SENDER_COMPANY=

# LLM provider (SiliconFlow is supported by this repository)
LLM_PROVIDER=siliconflow
SILICONFLOW_API_KEY=replace_with_your_siliconflow_api_key
SILICONFLOW_MODEL=replace_with_a_supported_model_id
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Optional internal WeCom notifications (leave empty to disable)
WECOM_WEBHOOK_URL=
